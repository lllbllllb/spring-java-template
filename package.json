{
  "name": "spring-java-template",
  "version": "0.0.1",
  "scripts": {
    "test:clean": "rimraf test/project/",
    "test:generate": "asyncapi generate fromTemplate test/fixtures/asyncapi.yml ./ -o test/project/src/main/java -p javaPackage=com.example.demo --force-write",
    "test:start": "python test/project/test.java",
    "test": "npm run test:clean && npm run test:generate"
  },
  "keywords": [],
  "author": "lllbllllb",
  "description": "test AsyncAPI template",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.5.1"
  },
  "generator": {
    "renderer": "react",
    "apiVersion": "v3",
    "generator": ">=2.0.0 <4.0.0",
    "supportedProtocols": [
      "kafka"
    ],
    "parameters": {
      "javaPackage": {
        "description": "Java package",
        "required": true
      }
    }
  },
  "dependencies": {
    "@asyncapi/generator-react-sdk": "^1.1.3",
    "@asyncapi/modelina": "^5.10.1",
    "@types/node": "^26.1.2",
    "@asyncapi/generator": "3.3.0",
    "@asyncapi/parser": "^3.6.1"
  },
  "devDependencies": {
    "debug": "^4.4.3",
    "rimraf": "^6.1.3"
  }
}
